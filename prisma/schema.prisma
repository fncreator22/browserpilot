generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  jobs Job[]

  @@map("users")
}

model Job {
  id              String              @id
  userId          String?
  prompt          String
  status          String              @default("QUEUED")
  progress        Int                 @default(0)
  allowedDomains  String              @default("[]")
  maxStepsBudget  Int                 @default(15)
  goal            String?
  confidence      Float?
  summary         String?
  error           String?
  result          String?
  totalDurationMs Int?
  tokensUsed      Int?
  memoryMb        Float?
  maxDurationMs   Int                 @default(120000)
  startedAt       DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  completedAt     DateTime?

  user         User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  steps        JobStep[]
  observations ObservationRecord[]
  artifacts    ArtifactRecord[]

  @@index([status])
  @@index([createdAt])
  @@map("jobs")
}

model JobStep {
  id            String   @id @default(cuid())
  jobId         String
  stepNumber    Int
  tool          String
  actionPayload String
  rationale     String?
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, stepNumber])
  @@map("job_steps")
}

model ObservationRecord {
  id             String   @id @default(cuid())
  jobId          String
  stepIndex      Int
  tool           String
  status         String
  currentUrl     String
  title          String
  pageSummary    String?
  extractedData  String?
  screenshotPath String?
  error          String?
  elapsedMs      Int
  timestamp      DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, stepIndex])
  @@map("observations")
}

model ArtifactRecord {
  id         String   @id @default(cuid())
  jobId      String
  filename   String
  storageKey String
  mimeType   String   @default("image/png")
  sizeBytes  Int      @default(0)
  createdAt  DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("artifacts")
}
