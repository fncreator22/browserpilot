generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(cuid())
  name         String?
  email        String   @unique
  passwordHash String
  geminiApiKey String?
  role         String   @default("USER")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  jobs      Job[]
  searches  Search[]
  savedJobs SavedOpportunity[]
  alerts    LifecycleAlert[]
  discoveryWatch  DiscoveryWatch?
  discoveryRuns   DiscoveryRun[]
  discoveryEvents OpportunityDiscoveryEvent[]
  profile             UserProfile?
  providerConnections ProviderConnection[]
  aiUsageEvents       AIUsageEvent[]
  subscriptions       Subscription[]
  couponRedemptions   CouponRedemption[]
  paymentTransactions PaymentTransaction[]
  browserSessions     BrowserSession[]

  @@map("users")
}

model Search {
  id             String         @id @default(cuid())
  userId         String?
  rawQuery       String
  intentType     String         @default("JOB_SEARCH_GENERAL")
  parsedRole     String?
  parsedSkills   String         @default("[]")
  parsedLocation String?
  parsedWorkMode String         @default("ANY")
  targetGradYear Int?
  status         String         @default("COMPLETED")
  totalFound     Int            @default(0)
  createdAt      DateTime       @default(now())

  user    User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  results SearchResult[]

  @@index([userId])
  @@index([createdAt])
  @@map("searches")
}

model Opportunity {
  id              String             @id @default(cuid())
  canonicalHash   String             @unique
  title           String
  companyName     String
  location        String
  workMode        String             @default("ANY")
  experienceLevel String             @default("ENTRY_LEVEL")
  opportunityType String             @default("FULL_TIME")
  salaryMin       Float?
  salaryMax       Float?
  salaryCurrency  String?            @default("USD")
  description     String
  requirements    String             @default("[]")
  skills          String             @default("[]")
  primaryApplyUrl String
  firstSeenAt     DateTime           @default(now())
  lastVerifiedAt  DateTime           @default(now())
  status          String             @default("ACTIVE")

  sourceListings  SourceListing[]
  searchResults   SearchResult[]
  savedByUsers    SavedOpportunity[]
  alerts          LifecycleAlert[]
  discoveryEvents OpportunityDiscoveryEvent[]

  @@index([workMode])
  @@index([experienceLevel])
  @@index([lastVerifiedAt])
  @@map("opportunities")
}

model SourceListing {
  id                 String   @id @default(cuid())
  opportunityId      String
  sourcePlatform     String
  externalJobId      String?
  sourceUrl          String
  applyUrl           String
  screenshotPath     String?
  verificationStatus String   @default("VERIFIED")
  rawSnippet         String?
  seenAt             DateTime @default(now())

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([sourcePlatform, sourceUrl])
  @@index([opportunityId])
  @@map("source_listings")
}

model SearchResult {
  id            String   @id @default(cuid())
  searchId      String
  opportunityId String
  matchScore    Float    @default(0.0)
  rankPosition  Int      @default(0)
  createdAt     DateTime @default(now())

  search      Search      @relation(fields: [searchId], references: [id], onDelete: Cascade)
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([searchId, opportunityId])
  @@index([searchId, rankPosition])
  @@map("search_results")
}

model SavedOpportunity {
  id            String   @id @default(cuid())
  userId        String
  opportunityId String
  notes         String?
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([userId, opportunityId])
  @@index([userId])
  @@map("saved_opportunities")
}

model Job {
  id              String              @id
  userId          String?
  prompt          String
  status          String              @default("QUEUED")
  progress        Int                 @default(0)
  allowedDomains  String              @default("[]")
  maxStepsBudget  Int                 @default(15)
  goal            String?
  confidence      Float?
  summary         String?
  error           String?
  result          String?
  totalDurationMs Int?
  tokensUsed      Int?
  memoryMb        Float?
  maxDurationMs   Int                 @default(120000)
  startedAt       DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  completedAt     DateTime?

  user         User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  steps        JobStep[]
  observations ObservationRecord[]
  artifacts    ArtifactRecord[]

  @@index([status])
  @@index([createdAt])
  @@map("jobs")
}

model JobStep {
  id            String   @id @default(cuid())
  jobId         String
  stepNumber    Int
  tool          String
  actionPayload String
  rationale     String?
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, stepNumber])
  @@map("job_steps")
}

model ObservationRecord {
  id             String   @id @default(cuid())
  jobId          String
  stepIndex      Int
  tool           String
  status         String
  currentUrl     String
  title          String
  pageSummary    String?
  extractedData  String?
  screenshotPath String?
  error          String?
  elapsedMs      Int
  timestamp      DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, stepIndex])
  @@map("observations")
}

model ArtifactRecord {
  id         String   @id @default(cuid())
  jobId      String
  filename   String
  storageKey String
  mimeType   String   @default("image/png")
  sizeBytes  Int      @default(0)
  createdAt  DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("artifacts")
}

model LifecycleAlert {
  id             String   @id @default(cuid())
  userId         String
  opportunityId  String?
  transitionType String   // "EXPIRED" | "REMOVED" | "RECOVERED_ACTIVE"
  previousStatus String
  newStatus      String
  title          String
  companyName    String
  message        String
  isRead         Boolean  @default(false)
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([opportunityId])
  @@map("lifecycle_alerts")
}

model DiscoveryWatch {
  id                   String    @id @default(cuid())
  userId               String    @unique
  enabled              Boolean   @default(true)
  roles                String    @default("[]")
  skills               String    @default("[]")
  locations            String    @default("[]")
  companies            String    @default("[]")
  workModes            String    @default("[]")
  experienceLevels     String    @default("[]")
  opportunityTypes     String    @default("[]")
  preferredSources     String    @default("[]")
  minimumMatchScore    Float     @default(70.0)
  latestOnly           Boolean   @default(false)
  freshnessWindowHours Int       @default(48)
  scanIntervalHours    Int       @default(6)
  lastScannedAt        DateTime?
  nextScanAt           DateTime?
  lockedAt             DateTime?
  lockOwner            String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([enabled, nextScanAt])
  @@map("discovery_watches")
}

model DiscoveryRun {
  id                   String    @id @default(cuid())
  userId               String
  triggerType          String    @default("MANUAL") // MANUAL, SCHEDULED
  status               String    @default("RUNNING") // RUNNING, SUCCESS, PARTIAL_SUCCESS, FAILED, TIMEOUT
  startedAt            DateTime  @default(now())
  completedAt          DateTime?
  durationMs           Int?
  providersAttempted   Int       @default(0)
  providersSucceeded   Int       @default(0)
  providersFailed      Int       @default(0)
  candidatesFound      Int       @default(0)
  validCandidates      Int       @default(0)
  newOpportunities     Int       @default(0)
  newSources           Int       @default(0)
  alreadyKnown         Int       @default(0)
  reposted             Int       @default(0)
  notificationsCreated Int       @default(0)
  errorMessage         String?

  user   User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  events OpportunityDiscoveryEvent[]

  @@index([userId, startedAt])
  @@index([triggerType])
  @@map("discovery_runs")
}

model OpportunityDiscoveryEvent {
  id                  String   @id @default(cuid())
  runId               String
  userId              String
  opportunityId       String
  classification      String   // NEW_OPPORTUNITY, NEW_SOURCE, ALREADY_KNOWN, REPOSTED
  matchScore          Float    @default(0.0)
  freshnessClass      String   @default("UNKNOWN")
  notificationCreated Boolean  @default(false)
  discoveredAt        DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  run         DiscoveryRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  opportunity Opportunity  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([userId, opportunityId, runId])
  @@index([userId, discoveredAt])
  @@index([opportunityId])
  @@map("opportunity_discovery_events")
}

model UserProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  onboardingCompleted Boolean  @default(false)
  onboardingVersion   Int      @default(1)
  acquisitionSource   String?
  userCategory        String?
  usageContext        String?
  experienceLevel     String?
  preferredRoles      String   @default("[]")
  preferredLocations  String   @default("[]")
  preferredWorkModes  String   @default("[]")
  targetSkills        String   @default("[]")
  organizationName    String?
  organizationSize    String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model ProviderConnection {
  id                     String   @id @default(cuid())
  userId                 String
  provider               String   // PUTER, GEMINI_BYOK, OPENAI_BYOK, ANTHROPIC_BYOK
  connectionMethod       String   // PUTER_OAUTH, API_KEY, SERVER_MANAGED
  status                 String   @default("CONNECTED") // CONNECTED, DISCONNECTED, VERIFICATION_FAILED, EXPIRED, REVOKED
  providerUsername       String?
  maskedCredential       String?
  encryptedCredential     String?
  lastVerifiedAt         DateTime @default(now())
  lastVerificationStatus String   @default("VALID")
  metadata               String   @default("{}")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId, status])
  @@map("provider_connections")
}

model AIUsageEvent {
  id           String   @id @default(cuid())
  userId       String
  provider     String
  model        String
  operation    String   // PROMPT_ENHANCEMENT, ACTION_PLANNING, STRUCTURED_EXTRACTION, INTENT_PARSING, DISCOVERY_RANKING
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  totalTokens  Int      @default(0)
  durationMs   Int      @default(0)
  status       String   @default("SUCCESS") // SUCCESS, FAILED, RATE_LIMITED, QUOTA_EXCEEDED
  errorMessage String?
  timestamp    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, timestamp])
  @@index([provider, timestamp])
  @@map("ai_usage_events")
}

model Plan {
  id                       String   @id @default(cuid())
  code                     String   @unique // FREE, PREMIUM, ENTERPRISE
  name                     String
  description              String
  active                   Boolean  @default(true)
  priceMonthly             Float    @default(0.0)
  priceYearly              Float    @default(0.0)
  currency                 String   @default("USD")
  maxWatches               Int      @default(1)
  maxDailyDiscoveries      Int      @default(10)
  maxMonthlyAIOperations   Int      @default(100)
  allowedIntervals         String   @default("[\"TWENTY_FOUR_HOURS\"]")
  supportsCompanyTargeting Boolean  @default(false)
  supportsAdvancedFilters  Boolean  @default(false)
  supportsPuterPremium     Boolean  @default(false)
  supportsPriorityExecution Boolean @default(false)
  metadata                 String   @default("{}")
  createdAt                DateTime @default(now())
  updatedAt                DateTime @default(now()) @updatedAt

  subscriptions Subscription[]
  coupons       Coupon[]

  @@map("plans")
}

model Subscription {
  id                     String    @id @default(cuid())
  userId                 String
  planId                 String
  status                 String    @default("ACTIVE") // ACTIVE, TRIALING, PAST_DUE, CANCELLED, EXPIRED, PAUSED
  billingInterval        String    @default("MONTHLY") // MONTHLY, YEARLY, LIFETIME, CUSTOM
  currentPeriodStart     DateTime  @default(now())
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean   @default(false)
  cancelledAt            DateTime?
  paymentProvider        String?   // RAZORPAY, STRIPE, MANUAL_PROMO, COUPON
  providerSubscriptionId String?
  providerCustomerId     String?
  metadata               String    @default("{}")
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status])
  @@map("subscriptions")
}

model Coupon {
  id              String    @id @default(cuid())
  code            String    @unique // UPPERCASE code e.g. LAUNCH2026, STUDENT50, PREMIUMFREE
  description     String?
  discountType    String    @default("PERCENTAGE") // PERCENTAGE, FIXED_AMOUNT, PLAN_ACCESS
  discountValue   Float     @default(0.0)
  targetPlanId    String?
  maxRedemptions  Int       @default(100)
  redemptionCount Int       @default(0)
  validFrom       DateTime  @default(now())
  validUntil      DateTime?
  active          Boolean   @default(true)
  createdById     String?
  metadata        String    @default("{}")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  targetPlan  Plan?              @relation(fields: [targetPlanId], references: [id], onDelete: SetNull)
  redemptions CouponRedemption[]

  @@index([code, active])
  @@map("coupons")
}

model CouponRedemption {
  id              String   @id @default(cuid())
  couponId        String
  userId          String
  redeemedAt      DateTime @default(now())
  discountGranted Float    @default(0.0)
  metadata        String   @default("{}")

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([couponId, userId])
  @@index([userId])
  @@map("coupon_redemptions")
}

model PaymentTransaction {
  id                  String   @id @default(cuid())
  userId              String
  subscriptionId      String?
  planId              String?
  amount              Float
  currency            String   @default("USD")
  provider            String   @default("RAZORPAY") // RAZORPAY, STRIPE, MANUAL, MOCK
  providerOrderId     String?
  providerPaymentId   String?
  providerSignature   String?
  status              String   @default("PENDING") // PENDING, SUCCESS, FAILED, REFUNDED
  failureReason       String?
  metadata            String   @default("{}")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([providerOrderId])
  @@index([providerPaymentId])
  @@map("payment_transactions")
}

model DiscoverySource {
  id                   String    @id @default(cuid())
  name                 String    @unique
  type                 String    // AGGREGATOR, ATS_PORTAL, COMPANY_CAREERS, TECH_COMMUNITY, PUBLIC_BOARD, USER_CONNECTED
  baseUrl              String
  supportedCategories  String    @default("[]") // JSON array
  supportedLocations   String    @default("[]") // JSON array
  reliabilityScore     Float     @default(1.0)
  lastSuccessfulCrawlAt DateTime?
  lastFailedCrawlAt    DateTime?
  totalCrawls          Int       @default(0)
  successfulCrawls     Int       @default(0)
  failedCrawls         Int       @default(0)
  status               String    @default("HEALTHY") // HEALTHY, DEGRADED, BLOCKED, MAINTENANCE
  isPublic             Boolean   @default(true)
  requiresAuth         Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @default(now()) @updatedAt

  @@index([type])
  @@index([status])
  @@map("discovery_sources")
}

model CompanyIntelligence {
  id                 String    @id @default(cuid())
  companyName         String    @unique
  normalizedName     String    @unique
  officialCareerUrl  String?
  atsProvider        String?   // GREENHOUSE, ASHBY, LEVER, WORKABLE, CUSTOM
  atsUrl             String?
  knownSources       String    @default("[]") // JSON array
  lastDiscoveredAt   DateTime?
  lastCrawlAt        DateTime?
  freshnessScore     Float     @default(1.0)
  reliabilityScore   Float     @default(1.0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt

  @@index([normalizedName])
  @@index([atsProvider])
  @@index([lastCrawlAt])
  @@map("company_intelligence")
}

model BrowserSession {
  id              String    @id @default(cuid())
  userId          String
  source          String    // LINKEDIN, INDEED, GREENHOUSE, LEVER, ASHBY, WORKABLE, COMPANY_CAREERS
  status          String    @default("CONNECTED") // CONNECTED, EXPIRED, REVOKED, REQUIRES_VERIFICATION, DISCONNECTED
  encryptedState  String    // AES-256-GCM ciphertext of storage state / cookies
  authMethod      String    @default("STORAGE_STATE") // STORAGE_STATE, COOKIE_JAR, SESSION_TOKEN, CREDENTIAL_VAULT
  username        String?   // Optional masked identifier
  expiresAt       DateTime?
  lastVerifiedAt  DateTime?
  lastUsedAt      DateTime?
  metadata        String    @default("{}") // Safe non-sensitive attributes (JSON)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source])
  @@index([userId, status])
  @@index([source, status])
  @@index([expiresAt])
  @@map("browser_sessions")
}

model DiscoveryLearningSignal {
  id          String   @id @default(cuid())
  sourceName  String
  companyName String?
  signalType  String   // DISCOVERY_SUCCESS, CRAWL_FAILED, STALE_RESULT, OPPORTUNITY_SAVED, APPLICATION_STARTED, RATE_LIMITED, CAPTCHA_DETECTED
  scoreDelta  Float    @default(0.0)
  metadata    String   @default("{}")
  createdAt   DateTime @default(now())

  @@index([sourceName])
  @@index([companyName])
  @@index([signalType])
  @@index([createdAt])
  @@map("discovery_learning_signals")
}
